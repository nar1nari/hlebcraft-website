<%- include('components/header') %>
<%- include('components/whitelisted_modal') %>
<%- include('components/online_modal') %>
<%- include('components/mechanics_modal') %>
<%- include('components/error_modal') %>
<div
  class="relative h-100 lg:h-auto lg:aspect-1366/439 w-full overflow-hidden bg-linear-to-l from-primary/50 to-base z-0"
>
  <img
    id="thumb_l0"
    src="/images/thumb_l0.webp"
    class="blur-[3px] absolute inset-0 w-full h-full object-cover transition-transform duration-300 ease-out"
    fetchpriority="high"
  />
  <img
    id="thumb_l1"
    src="/images/thumb_l1.webp"
    class="blur-[2px] absolute inset-0 w-full h-full object-cover transition-transform duration-300 ease-out"
    fetchpriority="high"
  />
  <img
    id="thumb_l2"
    src="/images/thumb_l2.webp"
    class="blur-[1px] absolute inset-0 w-full h-full object-cover transition-transform duration-300 ease-out"
    fetchpriority="high"
  />
  <img
    id="thumb_l3"
    src="/images/thumb_l3.webp"
    class="absolute inset-0 w-full h-full object-cover transition-transform duration-300 ease-out"
    fetchpriority="high"
  />

  <div
    class="absolute inset-0 z-10 flex flex-col justify-center px-[5%] lg:px-[10%]"
  >
    <div class="flex items-center">
      <div class="indicator pb-2">
        <span
          class="indicator-item badge bg-warning/90 border-none text-xl select-none"
          >Season 3</span
        >
        <div class="flex items-center">
          <img alt="Лого" src="/images/logo.png" class="h-2/3 lg:h-full" />
          <h1
            class="text-4xl lg:text-5xl font-bold uppercase tracking-wider font-brand! select-none"
          >
            Хлебкрафт
          </h1>
        </div>
      </div>
    </div>
    <h1 class="text-2xl font-bold select-none pb-4">
      Приватный ванильный Minecraft сервер
    </h1>
    <div class="flex gap-2 pb-4 items-start">
      <div
        class="bg-base-300/70 backdrop-blur-xs text-base-content px-4 py-2 rounded-2xl font-mono text-lg border border-base-content/20 cursor-pointer select-none transition-all"
        data-text="mc.hlebcraft.su"
        onclick="
          navigator.clipboard.writeText(this.dataset.text);
          this.classList.add('bg-success/20', 'border-success/40', 'text-success');
          this.querySelector('span').textContent = 'Скопировано!';
          setTimeout(() => {
            this.classList.remove('bg-success/20', 'border-success/40', 'text-success');
            this.querySelector('span').textContent = this.dataset.text;
          }, 2000)
        "
      >
        <span>mc.hlebcraft.su</span>
      </div>
      <div
        class="bg-base-300/70 backdrop-blur-xs text-base-content px-4 py-2 rounded-2xl font-mono text-lg border border-base-content/20"
      >
        <span>JE 26.1.2</span>
      </div>
    </div>
    <p class="text-2xl font-bold border-l-2 pl-2 border-secondary">
      Успей стать одним из первых<br />на 3 сезоне!
    </p>
    <a href="#register" class="btn btn-primary w-max mt-4">
      Оформить проходку
    </a>
  </div>
</div>

<script src="/js/parallax.js"></script>

