<!DOCTYPE html>
<html lang="ru" class="scroll-smooth bg-base-100">
  <head>
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta charset="UTF-8" />
    <title>Хлебкрафт</title>
    <link href="/css/output.css" rel="stylesheet" />
  </head>
  <body>
    <main class="bg-base-200 min-h-screen flex flex-col justify-center items-center gap-4">
      <h1 class="text-2xl">
      <% if (cancelled) { %>
      Вы отменили оплату
      <% } else if (success) { %>
      Оплата прошла
      <% } else if (error) { %>
      <%= error.message %>
      </br>
        <a
          href="https://discord.gg/9uM4He42ZG"
          target="_blank"
          rel="noopener noreferrer"
          class="link"
        >
          Свяжитесь с администрацией
        </a>
        и укажите ID: <%= error.orderId %>.
      <% } %>
      </h1>
      <a class="btn btn-primary" href="/">Вернуться на сайт</a>
    </main>
  </body>
</html>
