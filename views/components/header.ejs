<!DOCTYPE html>
<%
const siteUrl = "https://hlebcraft.su";
const pageTitle = typeof title !== "undefined" ? title : "Хлебкрафт — Приватный ванильный Minecraft сервер";
const pageDescription = typeof description !== "undefined" ? description : "Хлебкрафт — приватный ванильный Minecraft сервер (JE 26.1.2). Дружное комьюнити, стабильный аптайм, кастомные механики без нарушения ванильного духа. Присоединяйся: mc.hlebcraft.su";
const pagePath = typeof canonical !== "undefined" ? canonical : "/";
const canonicalUrl = siteUrl + pagePath;
const pageOgImage = typeof ogImage !== "undefined" ? siteUrl + ogImage : siteUrl + "/images/opening.webp";
const robotsContent = typeof noindex !== "undefined" && noindex ? "noindex, nofollow" : "index, follow";
%>
<html lang="ru" class="scroll-smooth bg-base-200">
  <head>
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta charset="UTF-8" />
    <title><%= pageTitle %></title>
    <meta name="description" content="<%= pageDescription %>" />
    <meta name="robots" content="<%= robotsContent %>" />
    <meta name="author" content="Хлебкрафт" />
    <link rel="canonical" href="<%= canonicalUrl %>" />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Хлебкрафт" />
    <meta property="og:title" content="<%= pageTitle %>" />
    <meta property="og:description" content="<%= pageDescription %>" />
    <meta property="og:url" content="<%= canonicalUrl %>" />
    <meta property="og:image" content="<%= pageOgImage %>" />
    <meta property="og:locale" content="ru_RU" />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content="<%= pageTitle %>" />
    <meta name="twitter:description" content="<%= pageDescription %>" />
    <meta name="twitter:image" content="<%= pageOgImage %>" />

    <link href="/css/output.css" rel="stylesheet" />
    <link
      href="https://fonts.googleapis.com/css2?family=Rubik:wght@400;500;700&display=swap"
      rel="stylesheet"
    />
    <link rel="icon" type="image/x-icon" href="/favicon.ico" />
    <script src="/js/svg.js" defer></script>

    <script type="application/ld+json">
      <%- JSON.stringify({
        "@context": "https://schema.org",
        "@type": "Organization",
        "name": "Хлебкрафт",
        "url": siteUrl,
        "logo": siteUrl + "/images/logo.png",
        "sameAs": ["https://discord.gg/9uM4He42ZG", "https://www.tiktok.com/@hlebcraft"]
      }) %>
    </script>
    <script type="application/ld+json">
      <%- JSON.stringify({
        "@context": "https://schema.org",
        "@type": "WebSite",
        "name": "Хлебкрафт",
        "url": siteUrl
      }) %>
    </script>
  </head>

  <body class="bg-base-100 overflow-y-scroll">
    <header class="max-lg:collapse bg-base-200 w-full lg:pl-2 pr-2 z-30">
      <input id="navbar-1-toggle" class="peer hidden" type="checkbox" />
      <label
        for="navbar-1-toggle"
        class="fixed inset-0 hidden max-lg:peer-checked:block"
      ></label>
      <div class="collapse-title navbar">
        <div class="navbar-start">
          <label for="navbar-1-toggle" class="btn btn-ghost lg:hidden">
            <svg
              xmlns="http://www.w3.org/2000/svg"
              class="h-5 w-5"
              fill="none"
              viewBox="0 0 24 24"
              stroke="currentColor"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M4 6h16M4 12h8m-8 6h16"
              />
            </svg>
          </label>
          <a
            href="/"
            class="text-xl font-bold uppercase tracking-wider font-brand! select-none cursor-pointer flex items-center"
          >
            <div class="svg-logo w-8 h-8"></div>
            Хлебкрафт
          </a>
        </div>
        <div class="navbar-center hidden lg:flex gap-8 text-base-content/50">
          <a
            href="/"
            class="relative pb-1 transition-all duration-300 <%= page === 'about' ? 'text-primary' : 'hover:text-base-content/80' %> after:content-[''] after:absolute after:bottom-0 after:left-1/2 after:-translate-x-1/2 after:h-0.5 after:transition-all after:duration-300 <%= page === 'about' ? 'after:w-full after:bg-primary' : 'after:w-0 hover:after:w-full after:bg-current' %>"
          >
            О проекте
          </a>

          <a
            href="/rules"
            class="relative pb-1 transition-all duration-300 <%= page === 'rules' ? 'text-primary' : 'hover:text-base-content/80' %> after:content-[''] after:absolute after:bottom-0 after:left-1/2 after:-translate-x-1/2 after:h-0.5 after:transition-all after:duration-300 <%= page === 'rules' ? 'after:w-full after:bg-primary' : 'after:w-0 hover:after:w-full after:bg-current' %>"
          >
            Правила
          </a>

          <a
            href="/news"
            class="relative pb-1 transition-all duration-300 <%= page === 'news' ? 'text-primary' : 'hover:text-base-content/80' %> after:content-[''] after:absolute after:bottom-0 after:left-1/2 after:-translate-x-1/2 after:h-0.5 after:transition-all after:duration-300 <%= page === 'news' ? 'after:w-full after:bg-primary' : 'after:w-0 hover:after:w-full after:bg-current' %>"
          >
            Новости
          </a>
        </div>
        <div class="navbar-end">
          <a href="/#register" class="btn btn-primary">Играть</a>
        </div>
      </div>

      <div class="collapse-content lg:hidden z-1">
        <ul class="menu w-full">
          <li><a href="/">О проекте</a></li>
          <li><a href="/rules">Правила</a></li>
          <li><a href="/news">Новости</a></li>
        </ul>
      </div>
    </header>
  </body>
</html>
